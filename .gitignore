.env
.venv/
__pycache__/
*.pyc

# Datos generados (se reproducen con los scripts)
data/conversaciones.sqlite*
# fia_cache.sqlite y data/chroma/ se commitean para el deploy en Streamlit Cloud
# (reconstruirlos tarda ~35 min). Solo se ignoran los archivos temporales de SQLite.
data/fia_cache.sqlite-*
data/chroma/**/*-wal
data/chroma/**/*-shm
informes/*
!informes/.gitkeep

# PDFs del reglamento: se descargan de fia.com (ver README)
data/reglamento/*.pdf
# (data/reglamento/glosario.md sí se commitea: es contenido propio del grupo)
.pytest_cache/
