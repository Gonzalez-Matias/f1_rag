# Copiar a .env y completar con las claves. No commitear .env.

# Proveedor de chat: gemini | openai | deepseek | anthropic | ollama | lmstudio
# (desde la UI se puede elegir otro y cargar la clave solo para la sesión)
LLM_PROVIDER=gemini
# Modelo (vacío = el default del proveedor: gemini-2.5-flash, gpt-5-mini, deepseek-reasoner, claude-sonnet-5-5)
LLM_MODEL=
# Mostrar razonamiento del modelo si el proveedor lo devuelve
LLM_REASONING=true
LLM_MAX_RETRIES=6

# API keys (solo hacen falta las de los proveedores que se usen)
# GOOGLE_API_KEY es obligatoria: se usa para los embeddings del reglamento.
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Modelos locales (sin clave). URLs por defecto:
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# RAG del reglamento: párrafos + similitud del coseno
EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=5                 # párrafos por búsqueda
RAG_MIN_SIMILITUD=0.63      # coseno mínimo (calibrado con gemini-embedding-001: relevantes 0.66-0.83, ruido <= 0.62)
RAG_MAX_CHARS_PARRAFO=1200  # los párrafos más largos se parten

# Scraper FIA
# FIA_CRAWL_DELAY=10        # segundos entre pedidos a fia.com (robots.txt)
# FIA_LIVE_TTL=600          # refrescar la carrera en curso en cada consulta (segundos)
# FIA_CACHE_DB=data/fia_cache.sqlite
# CONVERSACIONES_DB=data/conversaciones.sqlite
